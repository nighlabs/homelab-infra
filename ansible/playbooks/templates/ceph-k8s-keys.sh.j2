#!/usr/bin/env bash
# =============================================================================
# GENERATED — DO NOT EDIT. Template: playbooks/templates/ceph-k8s-keys.sh.j2
# Rendered by ansible/playbooks/render-ceph-setup.yml.
#
# ⚠ THIS PRINTS TWO CEPHX KEYS — credentials — TO YOUR TERMINAL.
#
# That is the point: they are generated ON the Ceph cluster, so this is how they
# get from there into Bitwarden Secrets Manager, which is the only durable store
# for them (root CLAUDE.md, "Secrets"). They must never be committed, pasted
# into a manifest, or left in a file on a PVE node.
#
# Afterwards: clear your scrollback, and close the terminal if it logs to disk.
#
# Run on a Proxmox node:  bash ceph-k8s-keys.sh
# =============================================================================
set -Eeuo pipefail

RBD_CLIENT={{ ceph_csi.rbd_client | quote }}
CEPHFS_CLIENT={{ ceph_csi.cephfs_client | quote }}

[[ ${EUID} -eq 0 ]] || { echo "must run as root (ceph CLI needs /etc/pve/ceph.conf)."; exit 1; }

printf '\n\033[1;33m⚠ credentials follow — do not commit, do not paste into a manifest\033[0m\n\n'

# Also emitted here so a from-scratch reader has every value the cluster side
# needs in one place. Neither is a credential; both are environment topology,
# which is why they live in BWS too and reach gitops/ as ${placeholders}.
printf '  ceph_fsid       %s\n' "$(ceph fsid)"
printf '  ceph_mons       (one per line — the msgr1 addresses below)\n'
ceph mon dump --format json 2>/dev/null \
  | python3 -c '
import sys, json
d = json.load(sys.stdin)
for m in d["mons"]:
    # public_addrs carries both msgr2 (3300) and msgr1 (6789). ceph-csi takes
    # either; msgr1 is the compatible default and what PVE reports as `addr`.
    v1 = [a["addr"] for a in m["public_addrs"]["addrvec"] if a["type"] == "v1"]
    print("                  " + (v1[0] if v1 else m["addr"].split("/")[0]))
'

printf '\n  --- BWS secret name -> value ---------------------------------------\n\n'
printf '  ceph_k8s_rbd_key        %s\n' "$(ceph auth get-key "client.${RBD_CLIENT}")"
printf '  ceph_k8s_cephfs_key     %s\n' "$(ceph auth get-key "client.${CEPHFS_CLIENT}")"

cat <<'EOF'

  Store each of the four above in Bitwarden Secrets Manager under exactly
  those names (ansible/BWS-SECRETS.md), in the SAME project the control node's
  machine account reads. Then, on the control node:

      cd ansible
      uv run ansible-playbook playbooks/bootstrap-cluster.yml

  which seeds them into the cluster. Nothing here is ever committed.

  Afterwards, on this node:  rm -f /tmp/ceph-k8s-*.sh

EOF
