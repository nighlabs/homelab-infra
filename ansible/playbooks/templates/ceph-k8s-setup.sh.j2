#!/usr/bin/env bash
# =============================================================================
# GENERATED — DO NOT EDIT THIS FILE.
#
# Rendered by ansible/playbooks/render-ceph-setup.yml from
# inventory/group_vars/all/vars.yml (`ceph_csi`) + Bitwarden Secrets Manager.
# Edit the TEMPLATE (playbooks/templates/ceph-k8s-setup.sh.j2) and re-render;
# edits made here are lost on the next render, silently.
#
# Procedure, warnings and rollback: docs/proxmox-ceph-k8s-setup.md
# Why this design: docs/decisions/0006-ceph-csi-external-proxmox-ceph.md
#
# -----------------------------------------------------------------------------
# ⚠ THIS RUNS AS ROOT ON A LIVE PRODUCTION CEPH CLUSTER.
#
# That cluster serves Proxmox VM storage today. Everything below is ADDITIVE:
# it creates one new RBD pool, one new CephFS subvolumegroup, and two new cephx
# users. It never writes to an existing pool, never touches the CephFS root,
# and never modifies an existing cephx user.
#
# It is idempotent and refuses rather than clobbers: every create is guarded on
# the object not already existing, and an existing object that does not look
# like ours is a hard stop, not an overwrite.
# -----------------------------------------------------------------------------
#
# Run on ONE Proxmox node (any mon host):   bash ceph-k8s-setup.sh
# Then verify:                              bash ceph-k8s-verify.sh
# Then collect the keys for BWS:            bash ceph-k8s-keys.sh
# =============================================================================
set -Eeuo pipefail

RBD_POOL={{ ceph_csi.rbd_pool | quote }}
FS_NAME={{ ceph_csi.fs_name | quote }}
SVG={{ ceph_csi.subvolume_group | quote }}
RBD_CLIENT={{ ceph_csi.rbd_client | quote }}
CEPHFS_CLIENT={{ ceph_csi.cephfs_client | quote }}

# The subvolumegroup lives under the `volumes` prefix the mgr volumes module
# hard-codes; the cephfs client's mds cap is scoped to exactly this path.
SVG_PATH="/volumes/${SVG}"

say()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
info() { printf '    %s\n' "$*"; }
die()  { printf '\n\033[1;31mFATAL: %s\033[0m\n\n' "$*" >&2; exit 1; }

# -----------------------------------------------------------------------------
# Preflight — refuse early rather than half-apply
# -----------------------------------------------------------------------------
say "Preflight"

[[ ${EUID} -eq 0 ]] || die "must run as root (the ceph CLI reads /etc/pve/ceph.conf, which is root-only)."
command -v ceph >/dev/null || die "no \`ceph\` on PATH — run this on a Proxmox node that is part of the Ceph cluster."
command -v rbd  >/dev/null || die "no \`rbd\` on PATH."

ceph status >/dev/null 2>&1 || die "cannot reach the Ceph cluster (\`ceph status\` failed)."

HEALTH=$(ceph health --format json | python3 -c 'import sys,json; print(json.load(sys.stdin)["status"])')
info "cluster health: ${HEALTH}"
if [[ ${HEALTH} == "HEALTH_ERR" ]]; then
  die "cluster is HEALTH_ERR. Fix that before adding pools — do not stack a
       change on top of a broken cluster."
fi
if [[ ${HEALTH} != "HEALTH_OK" ]]; then
  info "NOTE: not HEALTH_OK. Continuing is usually fine for HEALTH_WARN, but read"
  info "      \`ceph health detail\` first and be sure the warning is unrelated."
  read -r -p "    Continue anyway? [y/N] " reply
  [[ ${reply} == [yY] ]] || die "aborted at operator request."
fi

# The CephFS we are joining must already exist — we never create one. Creating a
# second filesystem is the rejected alternative (it needs a second ACTIVE MDS,
# spending the standby redundancy PVE's production filesystem relies on).
ceph fs get "${FS_NAME}" >/dev/null 2>&1 \
  || die "CephFS '${FS_NAME}' does not exist. This script joins PVE's existing
       filesystem; it does not create one. Check ceph_fs_name in BWS against
       \`ceph fs ls\`."
info "CephFS '${FS_NAME}': present"

# -----------------------------------------------------------------------------
# 1. RBD pool for Kubernetes RWO volumes
# -----------------------------------------------------------------------------
say "RBD pool '${RBD_POOL}'"

if ceph osd pool get "${RBD_POOL}" size >/dev/null 2>&1; then
  # Already there. Only acceptable if it is OUR pool — i.e. tagged for rbd and
  # not claimed by PVE as a storage. Anything else means the name collides with
  # something real, and creating/initialising over it could hand Kubernetes a
  # pool full of live VM images.
  info "pool exists — verifying it is ours rather than clobbering it"
  APPS=$(ceph osd pool application get "${RBD_POOL}" --format json)
  echo "${APPS}" | grep -q '"rbd"' \
    || die "pool '${RBD_POOL}' exists but is NOT tagged for rbd (apps: ${APPS}).
       Refusing to touch it. Pick another name in ceph_csi.rbd_pool, or
       investigate what owns this pool."
  if pvesm status 2>/dev/null | awk '{print $1}' | grep -qx "${RBD_POOL}"; then
    die "pool '${RBD_POOL}' is registered as a PVE storage. That means Proxmox
       may place VM disks in it — exactly what ADR-0006 forbids. Refusing.
       Kubernetes gets a pool PVE does not know about."
  fi
  info "existing pool accepted (rbd-tagged, not a PVE storage)"
else
  info "creating pool (autoscaler picks pg_num; size/min_size match the cluster's other pools)"
  ceph osd pool create "${RBD_POOL}" --autoscale-mode on
  ceph osd pool set "${RBD_POOL}" size 3
  ceph osd pool set "${RBD_POOL}" min_size 2
  ceph osd pool application enable "${RBD_POOL}" rbd
  rbd pool init "${RBD_POOL}"
  info "created"
fi

# ⚠ Deliberately NOT added to PVE's storage list (`pvesm add rbd ...`). If PVE
# knew about this pool it could schedule VM disks into it, and the whole point
# of a separate pool is that the two tiers cannot collide.

# -----------------------------------------------------------------------------
# 2. CephFS subvolumegroup for Kubernetes RWX volumes
# -----------------------------------------------------------------------------
say "CephFS subvolumegroup '${SVG}' in '${FS_NAME}'"

if ceph fs subvolumegroup ls "${FS_NAME}" --format json \
     | grep -q "\"${SVG}\""; then
  info "subvolumegroup already exists — nothing to do"
else
  # Creating a group creates ${SVG_PATH} inside the filesystem. It does not
  # touch anything already in that filesystem (PVE's snippets/ISOs/backups live
  # outside /volumes entirely).
  ceph fs subvolumegroup create "${FS_NAME}" "${SVG}"
  info "created ${SVG_PATH}"
fi

# -----------------------------------------------------------------------------
# 3. cephx users — one per driver, each scoped to its own blast radius
# -----------------------------------------------------------------------------
# Two users rather than one so an RBD-side compromise does not also carry the
# CephFS caps. `ceph auth get-or-create` is idempotent for an IDENTICAL cap set
# and ERRORS if the user exists with different caps — which is what we want:
# a silent cap change is how you get a driver that works until it doesn't.
say "cephx users"

create_user() {
  local entity="$1"; shift
  if ceph auth get "${entity}" >/dev/null 2>&1; then
    info "${entity}: exists — leaving its caps untouched"
    info "  (to change caps deliberately: \`ceph auth caps ${entity} ...\`, then"
    info "   re-run ceph-k8s-verify.sh. Never \`auth del\` a user in use — every"
    info "   mounted volume on every node authenticates as it.)"
  else
    ceph auth get-or-create "${entity}" "$@" >/dev/null
    info "${entity}: created"
  fi
}

# RBD. `profile rbd` on mon carries `allow command "osd blocklist"`, which
# ceph-csi needs to fence a dead node's client before re-attaching its image
# elsewhere — the same failure path ADR-0006's Non-Graceful Node Shutdown
# handling depends on. Both osd and mgr profiles are pinned to OUR pool.
create_user "client.${RBD_CLIENT}" \
  mon "profile rbd" \
  osd "profile rbd pool=${RBD_POOL}" \
  mgr "profile rbd pool=${RBD_POOL}"

# CephFS. The mds cap is scoped to our subvolumegroup path, and the osd caps to
# this filesystem's two pools by tag.
#
# ⚠ `mgr "allow rw"` is broader than it looks and is NOT an oversight: subvolume
# create/delete/resize all run through the mgr `volumes` module, and Ceph ships
# no narrower profile for it. This is the one cap here that is not least
# privilege, and it is the reason the two users are split at all.
create_user "client.${CEPHFS_CLIENT}" \
  mon "allow r" \
  mgr "allow rw" \
  osd "allow rw tag cephfs metadata=${FS_NAME}, allow rw tag cephfs data=${FS_NAME}" \
  mds "allow rw path=${SVG_PATH}"

# -----------------------------------------------------------------------------
say "Done"
cat <<EOF

    Created (or confirmed) on this Ceph cluster:

      RBD pool ............. ${RBD_POOL}
      CephFS ............... ${FS_NAME}  (existing, joined — not created)
      subvolumegroup ....... ${SVG}  -> ${SVG_PATH}
      cephx users .......... client.${RBD_CLIENT}, client.${CEPHFS_CLIENT}

    Next:
      1. bash ceph-k8s-verify.sh    — read-only; confirms caps actually match
      2. bash ceph-k8s-keys.sh      — prints the two keys to store in BWS

EOF
