# Butane config for {{ hostname }} — rendered from the node map, then
# transpiled with `butane --strict` to Ignition and delivered as the
# config-drive user-data via `qm set --cicustom` (docs/decisions/0005-flatcar-k3s-sysext-ignition-config-drive.md).
#
# The two networkd units are rendered to <build>/files/ from their own Jinja2
# templates and pulled in here with `contents.local:` (transpiled with
# --files-dir <build>), which keeps YAML indentation sane.
variant: flatcar
version: 1.1.0

passwd:
  users:
    # Dedicated admin user (not `core` left as the only account) — key-only.
    - name: {{ node_user }}
      groups:
        - sudo
        - docker
      ssh_authorized_keys:
{% for key in ssh_authorized_keys %}
        - {{ key }}
{% endfor %}
    # Also key `core` for break-glass recovery; it has no password either.
    - name: core
      ssh_authorized_keys:
{% for key in ssh_authorized_keys %}
        - {{ key }}
{% endfor %}

storage:
  files:
    # Hostname from Ignition (no DHCP option 12 / reverse-DNS dependency).
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: {{ hostname }}

    # Static addressing — both NICs, bound by MAC.
    - path: /etc/systemd/network/00-eth0.network
      mode: 0644
      contents:
        local: files/00-eth0.network
    - path: /etc/systemd/network/10-eth1.network
      mode: 0644
      contents:
        local: files/10-eth1.network

    # Belt-and-suspenders: forbid password auth outright (key-only).
    - path: /etc/ssh/sshd_config.d/10-no-passwords.conf
      mode: 0600
      contents:
        inline: |
          PasswordAuthentication no
          KbdInteractiveAuthentication no

    # NOPASSWD sudo for the admin user — the account has no password, so
    # unattended `sudo reboot` (a definition-of-done check) would otherwise fail.
    - path: /etc/sudoers.d/10-{{ node_user }}
      mode: 0440
      contents:
        inline: |
          {{ node_user }} ALL=(ALL) NOPASSWD: ALL
{% if k3s_enabled %}

    # --- k3s (installed via the Flatcar k3s sysext) -----------------------
    # NOTE: the sysext .raw is deliberately NOT fetched here. Ignition's files
    # stage runs in the initramfs, which has NO network in this no-DHCP setup
    # (static addressing only activates after the pivot) — a remote `source:`
    # fetch there hangs and boot-loops. Instead k3s-sysext-download.service (see
    # the systemd section) pulls the image on first boot from the real root,
    # where the network is up, then merges the sysext and starts k3s.
    # k3s server config (server-only flags) — rendered from k3s-config.yaml.j2.
    - path: /etc/rancher/k3s/config.yaml
      mode: 0600
      contents:
        local: files/k3s-config.yaml
    # systemd-sysupdate transfer config, minor-pinned so only patch releases
    # within {{ k3s_minor }} auto-apply. Dir suffix = feature name k3s-{{ k3s_minor }}.
    - path: /etc/sysupdate.k3s-{{ k3s_minor }}.d/k3s-{{ k3s_minor }}.conf
      mode: 0644
      contents:
        local: files/k3s-sysupdate.conf
{% endif %}

  # Second virtio disk (virtio1 -> /dev/vdb) for local data, kept decoupled
  # from the OS disk so the boot disk can be rebuilt without losing this.
  disks:
    - device: /dev/vdb
      wipe_table: false
      partitions:
        - number: 1
          label: data
  filesystems:
    - path: {{ data_mount_point }}
      device: /dev/disk/by-partlabel/data
      format: ext4
      label: data
      # Reformat on a from-scratch rebuild — a stale FS signature would
      # otherwise make Ignition skip formatting (docs/worklog.md, 2026-07-07).
      wipe_filesystem: true
      with_mount_unit: true
{% if k3s_enabled %}

  links:
    # Enable k3s.service explicitly. The k3s sysext ships the unit but NO
    # auto-enable drop-in, and the unit file lives inside the sysext (absent at
    # Ignition-provision time), so we can't use systemd.units[].enabled. A wants/
    # symlink is provision-safe: it's a dangling ref on first boot (a harmless
    # "unit not found" warning) until k3s-sysext-download.service merges the
    # sysext and starts k3s; on later boots the cached sysext merges early and
    # this starts k3s normally.
    #
    # We deliberately do NOT create /etc/extensions/k3s.raw here: on first boot
    # its target doesn't exist yet, and a dangling symlink at the early
    # systemd-sysext merge risks breaking the docker/containerd sysexts. The
    # download unit creates that symlink after the image lands (and
    # systemd-sysupdate re-points it on later patch updates).
    - path: /etc/systemd/system/multi-user.target.wants/k3s.service
      target: /usr/local/lib/systemd/system/k3s.service
      hard: false
{% endif %}
{% if k3s_enabled %}

systemd:
  units:
    # Merge sysext images (docker/containerd always; k3s once downloaded) at boot.
    - name: systemd-sysext.service
      enabled: true
    # First-boot (and post-rebuild) download of the k3s sysext from the REAL
    # ROOT, where the static network is up — Ignition can't fetch it in the
    # initramfs (no DHCP). Idempotent: the Condition skips it once the .raw is
    # present, so reboots merge the cached image early and start k3s via the
    # wants/ symlink. On first boot it downloads, symlinks it into
    # /etc/extensions/, re-merges sysext, then starts k3s.
    - name: k3s-sysext-download.service
      enabled: true
      contents: |
        [Unit]
        Description=Download and activate the k3s sysext on first boot
        Wants=network-online.target
        After=network-online.target
        # Skip once the image exists (every boot after a successful first boot).
        ConditionPathExists=!/opt/extensions/k3s/k3s-{{ k3s_version }}-x86-64.raw
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=/usr/bin/mkdir -p /opt/extensions/k3s
        ExecStart=/usr/bin/curl -fsSL --retry 20 --retry-delay 3 --retry-connrefused -o /opt/extensions/k3s/k3s-{{ k3s_version }}-x86-64.raw.part https://extensions.flatcar.org/extensions/k3s-{{ k3s_version }}-x86-64.raw
        ExecStart=/usr/bin/mv /opt/extensions/k3s/k3s-{{ k3s_version }}-x86-64.raw.part /opt/extensions/k3s/k3s-{{ k3s_version }}-x86-64.raw
        ExecStart=/usr/bin/ln -sf /opt/extensions/k3s/k3s-{{ k3s_version }}-x86-64.raw /etc/extensions/k3s.raw
        ExecStart=/usr/bin/systemctl restart systemd-sysext.service
        ExecStart=/usr/bin/systemctl daemon-reload
        ExecStart=/usr/bin/systemctl --no-block start k3s.service
        [Install]
        WantedBy=multi-user.target
    # Periodic update check for the pinned k3s minor (patch releases only).
    - name: systemd-sysupdate.timer
      enabled: true
    # The base systemd-sysupdate.service only updates the OS. This drop-in makes
    # each run also pull the k3s feature (-C k3s-{{ k3s_minor }}) and, if the
    # active .raw changed, flag a reboot — the new k3s binary is applied on the
    # next boot rather than hot-swapped under the running service. Mirrors the
    # sysext-bakery's published drop-in. (Actual pull-through is the §7-item-5
    # PoC; this wires the machinery.)
    - name: systemd-sysupdate.service
      dropins:
        - name: k3s.conf
          contents: |
            [Service]
            ExecStartPre=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/k3s.raw > /tmp/k3s-sysext-old"
            ExecStartPre=/usr/lib/systemd/systemd-sysupdate -C k3s-{{ k3s_minor }} update
            ExecStartPost=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/k3s.raw > /tmp/k3s-sysext-new"
            ExecStartPost=/usr/bin/sh -c "if ! cmp --silent /tmp/k3s-sysext-old /tmp/k3s-sysext-new; then touch /run/reboot-required; fi"
    # Order k3s after the sysext is merged (its binary must exist) AND the data
    # disk is mounted (data-dir lives there, else the datastore lands on the OS
    # disk). Enablement is via the wants/ symlink above, not `enabled:` here —
    # the unit is absent at provision time.
    - name: k3s.service
      dropins:
        - name: 10-after-sysext-and-data.conf
          contents: |
            [Unit]
            After=systemd-sysext.service k3s-sysext-download.service
            RequiresMountsFor={{ data_mount_point }}
{% endif %}
